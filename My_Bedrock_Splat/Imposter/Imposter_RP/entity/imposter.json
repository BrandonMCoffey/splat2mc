{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "custom:imposter",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/imposter_sheet"
      },
      "geometry": {
        "default": "geometry.imposter"
      },
      "scripts": {
        "pre_animation": [
          "v.frame_w = 512;",
          "v.frame_h = 512;",
          
          "v.delta_yaw = math.mod(query.camera_rotation(1) - query.body_y_rotation + 180 + 360, 360);",
          "v.col = math.mod(math.round(v.delta_yaw / 22.5), 16);",
          
          "v.pitch = query.camera_rotation(0);",
          "v.row = v.pitch > 25 ? 0 : (v.pitch < -25 ? 2 : 1);"
        ]
      },
      "render_controllers": [
        "controller.render.imposter"
      ]
    }
  }
}