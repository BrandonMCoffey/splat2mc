      "scripts": {
        "animate": [ "look_at" ],
        "pre_animation": [
          "v.rel_yaw = query.rotation_to_camera(1) - query.body_y_rotation;",
          "v.snapped_yaw = math.round(v.rel_yaw / 11.25) * 11.25;",
          "v.col = math.mod((v.snapped_yaw / 11.25) + 720, 32);",

          "v.pitch = query.rotation_to_camera(0);",
          "v.row = v.pitch > 25 ? 0 : (v.pitch < -25 ? 2 : 1);",
          "v.snapped_pitch = v.row == 0 ? 35 : (v.row == 2 ? -35 : 0);",

          "v.frame_index = (v.row * 32) + v.col;"
        ]
      },
      "render_controllers": [
        "controller.render.imposter"
      ]
